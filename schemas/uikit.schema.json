{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UIKit JSON Schema",
  "description": "Schema for recursica_ui-kit.json structure",
  "type": "object",
  "required": ["ui-kit"],

  "definitions": {
    "dtcgToken": {
      "type": "object",
      "required": ["$value"],
      "properties": {
        "$type": { "type": "string" },
        "$value": {},
        "$description": { "type": "string" },
        "$extensions": { "type": "object" },
        "$deprecated": {},
        "$extends": {}
      },
      "additionalProperties": false
    }
  },

  "properties": {
    "ui-kit": {
      "type": "object",
      "required": ["globals"],
      "properties": {
        "globals": {
          "type": "object",
          "properties": {
            "icon": { "type": "object" },
            "form": { "type": "object" },
            "indicators": { "type": "object" },
            "field": { "type": "object" },
            "label": { "type": "object" },
            "assistive-elements": { "type": "object" }
          },
          "additionalProperties": true
        },
        "components": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "type": "object",
              "properties": {
                "variants": {
                  "type": "object",
                  "additionalProperties": true
                },
                "properties": {
                  "type": "object",
                  "description": "Component-level property tokens.",
                  "additionalProperties": true
                },
                "size": { "type": "object" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
