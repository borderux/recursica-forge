# Dependencies
node_modules

# Production build
/dist

# TypeScript build info
*.tsbuildinfo

# Vite cache
/.vite

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log
*.debug.log

# Editor directories and files
.DS_Store
