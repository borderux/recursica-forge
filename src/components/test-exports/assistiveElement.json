{
  "ui-kit": {
    "components": {
      "assistive-element": {
        "variants": {
          "types": {
            "help": {
              "properties": {
                "colors": {
                  "layer-0": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.properties.border-color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.properties.border-color}"
                    }
                  },
                  "layer-1": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-1.properties.border-color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-1.properties.border-color}"
                    }
                  },
                  "layer-2": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.properties.border-color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.properties.border-color}"
                    }
                  },
                  "layer-3": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-3.properties.border-color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-3.properties.border-color}"
                    }
                  }
                }
              }
            },
            "error": {
              "properties": {
                "colors": {
                  "layer-0": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.elements.text.color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.elements.text.color}"
                    }
                  },
                  "layer-1": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-1.elements.text.color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-1.elements.text.color}"
                    }
                  },
                  "layer-2": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.elements.text.color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.elements.text.color}"
                    }
                  },
                  "layer-3": {
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-3.elements.text.color}"
                    },
                    "icon-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-3.elements.text.color}"
                    }
                  }
                }
              }
            }
          }
        },
        "properties": {
          "text": {
            "font-family": {
              "$type": "string",
              "$value": "{brand.fonts.secondary}"
            },
            "font-size": {
              "$type": "dimension",
              "$value": "{tokens.font.sizes.xs}"
            },
            "font-weight": {
              "$type": "number",
              "$value": "{tokens.opacities.ghost}"
            },
            "letter-spacing": {
              "$type": "string",
              "$value": "{tokens.font.styles.normal}"
            },
            "line-height": {
              "$type": "number",
              "$value": "{tokens.font.line-heights.shorter}"
            },
            "text-decoration": {
              "$type": "string",
              "$value": "{tokens.font.letter-spacings.default}"
            },
            "text-transform": {
              "$type": "string",
              "$value": "{tokens.font.cases.uppercase}"
            },
            "font-style": {
              "$type": "string",
              "$value": "{ui-kit.components.button}"
            }
          },
          "icon-size": {
            "$type": "dimension",
            "$value": "{brand.dimensions.text-size.default}"
          },
          "icon-text-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "top-margin": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.lg}"
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 5
            }
          }
        }
      }
    }
  }
}