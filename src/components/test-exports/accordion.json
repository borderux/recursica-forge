{
  "ui-kit": {
    "components": {
      "accordion": {
        "properties": {
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.sm}"
          },
          "item-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.sm}"
          },
          "padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.sm}"
          },
          "min-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 224
            }
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 16
            }
          },
          "elevation": {
            "$value": "{brand.elevations.elevation-1}",
            "$extensions": {
              "recursica.type": "elevation"
            }
          },
          "divider-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "colors": {
            "layer-0": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.surface}"
              }
            },
            "layer-1": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.surface}"
              }
            },
            "layer-2": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.surface}"
              }
            },
            "layer-3": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.surface}"
              }
            }
          }
        }
      }
    }
  }
}