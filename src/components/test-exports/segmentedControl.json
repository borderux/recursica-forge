{
  "ui-kit": {
    "components": {
      "segmented-control": {
        "variants": {
          "orientation": {
            "horizontal": {
              "properties": {}
            },
            "vertical": {
              "properties": {}
            }
          },
          "fill-width": {
            "false": {
              "properties": {}
            },
            "true": {
              "properties": {}
            }
          }
        },
        "properties": {
          "colors": {
            "layer-0": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.1000.color.on-tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              }
            },
            "layer-1": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.1000.color.on-tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              }
            },
            "layer-2": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.1000.color.on-tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              }
            },
            "layer-3": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.1000.color.on-tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.interactive.tone}"
              }
            }
          },
          "elevation": {
            "$value": "{brand.elevations.elevation-1}",
            "$extensions": {
              "recursica.type": "elevation"
            }
          },
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 100
            }
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.default}"
          },
          "padding-horizontal": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "padding-vertical": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "item-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "divider-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          }
        }
      }
    }
  }
}