{
  "ui-kit": {
    "components": {
      "menu": {
        "properties": {
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.lg}"
          },
          "min-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 1500
            }
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 48
            }
          },
          "padding": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 0
            }
          },
          "item-gap": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 0
            }
          },
          "max-height": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 624
            }
          },
          "elevation": {
            "$value": "{brand.elevations.elevation-2}",
            "$extensions": {
              "recursica.type": "elevation"
            }
          },
          "divider-height": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "divider-opacity": {
            "$type": "number",
            "$value": 4
          },
          "colors": {
            "layer-0": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.surface}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.100.color.on-tone}"
              }
            },
            "layer-1": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.surface}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.100.color.on-tone}"
              }
            },
            "layer-2": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.elements.interactive.tone}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.surface}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.100.color.on-tone}"
              }
            },
            "layer-3": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.core-colors.alert.interactive}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.surface}"
              },
              "divider-color": {
                "$type": "color",
                "$value": "{brand.palettes.neutral.100.color.on-tone}"
              }
            }
          }
        }
      }
    }
