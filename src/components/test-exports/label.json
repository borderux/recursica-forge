{
  "ui-kit": {
    "components": {
      "label": {
        "variants": {
          "layouts": {
            "stacked": {
              "properties": {
                "bottom-padding": {
                  "$type": "dimension",
                  "$value": "{brand.dimensions.general.lg}"
                },
                "min-height": {
                  "$type": "dimension",
                  "$value": {
                    "unit": "px",
                    "value": 224
                  }
                }
              },
              "variants": {
                "sizes": {
                  "default": {
                    "properties": {
                      "width": {
                        "$type": "dimension",
                        "$value": {
                          "unit": "px",
                          "value": 24
                        }
                      }
                    }
                  },
                  "small": {
                    "properties": {
                      "width": {
                        "$type": "dimension",
                        "$value": {
                          "unit": "px",
                          "value": 8
                        }
                      }
                    }
                  }
                }
              }
            },
            "side-by-side": {
              "properties": {
                "min-height": {
                  "$type": "dimension",
                  "$value": {
                    "unit": "px",
                    "value": 4
                  }
                },
                "gutter": {
                  "$type": "dimension",
                  "$value": "{ui-kit.globals.form.properties.label-field-gap-vertical}"
                },
                "vertical-padding": {
                  "$type": "dimension",
                  "$value": "{ui-kit.globals.table.cell.padding-horizontal}"
                }
              },
              "variants": {
                "sizes": {
                  "default": {
                    "properties": {
                      "width": {
                        "$type": "dimension",
                        "$value": {
                          "unit": "px",
                          "value": 24
                        }
                      }
                    }
                  },
                  "small": {
                    "properties": {
                      "width": {
                        "$type": "dimension",
                        "$value": {
                          "unit": "px",
                          "value": 8
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "properties": {
          "colors": {
            "layer-0": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              },
              "asterisk-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.elements.text.color}"
              }
            },
            "layer-1": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              },
              "asterisk-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.elements.text.color}"
              }
            },
            "layer-2": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              },
              "asterisk-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.elements.text.color}"
              }
            },
            "layer-3": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              },
              "asterisk-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.elements.text.color}"
              }
            }
          },
          "label-text": {
            "font-family": {
              "$type": "string",
              "$value": "{tokens.font.cases.original}"
            },
            "font-size": {
              "$type": "dimension",
              "$value": "{tokens.font.sizes.xs}"
            },
            "font-weight": {
              "$type": "number",
              "$value": "{tokens.opacities.ghost}"
            },
            "letter-spacing": {
              "$type": "string",
              "$value": "{tokens.font.styles.normal}"
            },
            "line-height": {
              "$type": "number",
              "$value": "{tokens.font.line-heights.shorter}"
            },
            "text-decoration": {
              "$type": "string",
              "$value": "{tokens.font.letter-spacings.default}"
            },
            "text-transform": {
              "$type": "string",
              "$value": "{tokens.font.cases.uppercase}"
            },
            "font-style": {
              "$type": "string",
              "$value": "{ui-kit.components.button}"
            }
          },
          "optional-text": {
            "font-family": {
              "$type": "string",
              "$value": "{brand.fonts.secondary}"
            },
            "font-size": {
              "$type": "dimension",
              "$value": "{ui-kit.globals.form.field.size.border-radius}"
            },
            "font-weight": {
              "$type": "number",
              "$value": "{tokens.opacities.ghost}"
            },
            "letter-spacing": {
              "$type": "string",
              "$value": "{tokens.font.styles.normal}"
            },
            "line-height": {
              "$type": "number",
              "$value": "{tokens.font.line-heights.shorter}"
            },
            "text-decoration": {
              "$type": "string",
              "$value": "{tokens.font.letter-spacings.default}"
            },
            "text-transform": {
              "$type": "string",
              "$value": "{tokens.font.cases.uppercase}"
            },
            "font-style": {
              "$type": "string",
              "$value": "{ui-kit.components.button}"
            }
          },
          "required-indicator-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.lg}"
          },
          "label-optional-text-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "edit-icon-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "optional-text-opacity": {
            "$type": "number",
            "$value": "{tokens.font.letter-spacings.default}"
          }
        }
      }
    }
  }
}