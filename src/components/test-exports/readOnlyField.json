{
  "ui-kit": {
    "components": {
      "read-only-field": {
        "variants": {
          "layouts": {
            "stacked": {
              "properties": {
                "top-bottom-margin": {
                  "$type": "dimension",
                  "$value": "{ui-kit.globals.table.cell.padding-horizontal}"
                }
              }
            },
            "side-by-side": {
              "properties": {
                "top-bottom-margin": {
                  "$type": "dimension",
                  "$value": "{ui-kit.globals.table.cell.padding-horizontal}"
                }
              }
            }
          }
        },
        "properties": {
          "colors": {
            "layer-0": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              }
            },
            "layer-1": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              }
            },
            "layer-2": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              }
            },
            "layer-3": {
              "text-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              }
            }
          },
          "text": {
            "font-family": {
              "$type": "string",
              "$value": "{brand.fonts.secondary}"
            },
            "font-size": {
              "$type": "dimension",
              "$value": "{tokens.font.sizes.xs}"
            },
            "font-weight": {
              "$type": "number",
              "$value": "{tokens.opacities.ghost}"
            },
            "letter-spacing": {
              "$type": "string",
              "$value": "{tokens.font.styles.normal}"
            },
            "line-height": {
              "$type": "number",
              "$value": "{tokens.font.line-heights.shorter}"
            },
            "text-decoration": {
              "$type": "string",
              "$value": "{tokens.font.letter-spacings.default}"
            },
            "text-transform": {
              "$type": "string",
              "$value": "{tokens.font.cases.uppercase}"
            },
            "font-style": {
              "$type": "string",
              "$value": "{ui-kit.components.button}"
            }
          },
          "min-height": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 36
            }
          }
        }
      }
    }
  }
}