                    "value": 3,
                    "unit": "px"
                  }
                }
              }
            },
            "default": {
              "properties": {
                "size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 36,
                    "unit": "px"
                  }
                },
                "border-radius": {
                  "$type": "dimension",
                  "$value": {
                    "value": 9999,
                    "unit": "px"
                  }
                },
                "thickness-size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 4,
                    "unit": "px"
                  }
                }
              }
            },
            "large": {
              "properties": {
                "size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 48,
                    "unit": "px"
                  }
                },
                "border-radius": {
                  "$type": "dimension",
                  "$value": {
                    "value": 9999,
                    "unit": "px"
                  }
                },
                "thickness-size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 5,
                    "unit": "px"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}