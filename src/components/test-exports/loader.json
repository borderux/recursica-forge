{
  "ui-kit": {
    "components": {
      "loader": {
        "properties": {
          "indicator-color": {
            "$type": "color",
            "$value": "{brand.palettes.core-colors.interactive.tone}"
          }
        },
        "variants": {
          "sizes": {
            "small": {
              "properties": {
                "size": {
                  "$type": "dimension",
