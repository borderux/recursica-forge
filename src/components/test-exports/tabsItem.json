                      "border-size": {
                        "$type": "dimension",
                        "$value": {
                          "value": 1,
                          "unit": "px"
                        }
                      },
                      "text": {
                        "font-family": {
                          "$type": "string",
                          "$value": "{brand.fonts.primary}"
                        },
                        "font-size": {
                          "$type": "dimension",
                          "$value": "{tokens.font.sizes.md}"
                        },
                        "font-weight": {
                          "$type": "number",
                          "$value": "{tokens.font.weights.regular}"
                        },
                        "letter-spacing": {
                          "$type": "string",
                          "$value": "{tokens.font.letter-spacings.default}"
                        },
                        "line-height": {
                          "$type": "number",
                          "$value": "{tokens.font.line-heights.default}"
                        },
                        "text-decoration": {
                          "$type": "string",
                          "$value": "{tokens.font.decorations.none}"
                        },
                        "text-transform": {
                          "$type": "string",
                          "$value": "{tokens.font.cases.original}"
                        },
                        "font-style": {
                          "$type": "string",
                          "$value": "{tokens.font.styles.normal}"
                        }
                      }
                    }
                  }
                },
                "orientation": {
                  "horizontal": {
                    "properties": {
                      "tab-content-alignment": {
                        "$type": "string",
                        "$value": "center"
                      }
                    }
                  },
                  "vertical": {
                    "properties": {
                      "tab-content-alignment": {
                        "$type": "string",
                        "$value": "left"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
