                    }
                  },
                  "layer-3": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.on-tone}"
                    }
                  }
                },
                "elevation": {
                  "$value": "{brand.elevations.elevation-1}",
                  "$extensions": {
                    "recursica.type": "elevation"
                  }
                },
                "border-size": {
                  "$type": "dimension",
                  "$value": {
                    "value": 1,
                    "unit": "px"
                  }
                },
                "border-radius": {
                  "$type": "dimension",
                  "$value": "{brand.dimensions.border-radii.2xl}"
                },
                "text": {
                  "font-family": {
                    "$type": "string",
                    "$value": "{brand.fonts.secondary}"
                  },
                  "font-size": {
                    "$type": "dimension",
                    "$value": "{tokens.font.sizes.md}"
                  },
                  "font-weight": {
                    "$type": "number",
                    "$value": "{tokens.font.weights.regular}"
                  },
                  "letter-spacing": {
                    "$type": "string",
                    "$value": "{tokens.font.letter-spacings.default}"
                  },
                  "line-height": {
                    "$type": "number",
                    "$value": "{tokens.font.line-heights.default}"
                  },
                  "text-decoration": {
                    "$type": "typography",
                    "$value": "{tokens.font.decorations.none}"
                  },
                  "text-transform": {
                    "$type": "typography",
                    "$value": "{tokens.font.cases.original}"
                  },
                  "font-style": {
                    "$type": "typography",
                    "$value": "{tokens.font.styles.normal}"
                  }
                }
              }
            },
            "unselected": {
