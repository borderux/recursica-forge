                    },
                    "border-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.on-tone}"
                    }
                  },
                  "layer-1": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.on-tone}"
                    }
                  },
                  "layer-2": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.core-colors.interactive.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "text-color": {
                      "$type": "color",
