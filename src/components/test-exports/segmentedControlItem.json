                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.elements.text.color}"
                    }
                  },
                  "layer-3": {
                    "background-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": null
                    },
                    "text-color": {
                      "$type": "color",
