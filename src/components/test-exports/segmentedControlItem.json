                "text": {
                  "font-family": {
                    "$type": "string",
                    "$value": "{brand.fonts.secondary}"
                  },
                  "font-size": {
                    "$type": "dimension",
                    "$value": "{tokens.font.sizes.md}"
                  },
                  "font-weight": {
                    "$type": "number",
                    "$value": "{tokens.font.weights.regular}"
                  },
                  "letter-spacing": {
                    "$type": "string",
                    "$value": "{tokens.font.letter-spacings.default}"
                  },
                  "line-height": {
                    "$type": "number",
                    "$value": "{tokens.font.line-heights.default}"
                  },
                  "text-decoration": {
                    "$type": "typography",
                    "$value": "{tokens.font.decorations.none}"
                  },
                  "text-transform": {
                    "$type": "typography",
                    "$value": "{tokens.font.cases.original}"
                  },
                  "font-style": {
                    "$type": "typography",
                    "$value": "{tokens.font.styles.normal}"
                  }
                }
              }
            }
          }
        },
        "properties": {
          "item": {
            "colors": {},
            "padding-horizontal": {
              "$type": "dimension",
              "$value": "{brand.dimensions.general.lg}"
            },
            "height": {
