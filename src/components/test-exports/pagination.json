{
  "ui-kit": {
    "components": {
      "pagination": {
        "properties": {
          "colors": {
            "layer-0": {
              "dots-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              }
            },
            "layer-1": {
              "dots-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              }
            },
            "layer-2": {
              "dots-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              }
            },
            "layer-3": {
              "dots-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              }
            }
          },
          "item-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "inactive-pages": {
            "$value": "center",
            "$extensions": {
              "recursica.component": {
                "selected-variants": {
                  "style": "{ui-kit.components.button.variants.styles.outline}",
                  "size": "{ui-kit.components.button.variants.sizes.small}"
                }
              }
            }
          },
          "navigation-controls": {
            "$value": "center",
            "$extensions": {
              "recursica.component": {
                "selected-variants": {
                  "style": "{ui-kit.components.button.variants.styles.text}",
                  "size": "{ui-kit.components.button.variants.sizes.small}",
                  "content": "{ui-kit.components.button.variants.content.icon-only}"
                }
              }
            }
          }
        },
        "variants": {
          "states": {
            "active": {
              "properties": {
                "pages": {
                  "$value": "center",
                  "$extensions": {
                    "recursica.component": {
                      "selected-variants": {
                        "style": "{ui-kit.components.button.variants.styles.solid}",
                        "size": "{ui-kit.components.button.variants.sizes.small}"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}