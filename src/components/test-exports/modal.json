{
  "ui-kit": {
    "components": {
      "modal": {
        "properties": {
          "colors": {
            "layer-0": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.elements.interactive.tone}"
              },
              "scroll-divider": {
                "$type": "color",
                "$value": "{brand.palettes.palette-1.100.color.on-tone}"
              },
              "title": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.surface}"
              }
            },
            "layer-1": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.elements.interactive.tone}"
              },
              "scroll-divider": {
                "$type": "color",
                "$value": "{brand.palettes.palette-1.100.color.on-tone}"
              },
              "title": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.surface}"
              }
            },
            "layer-2": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.core-colors.alert.interactive}"
              },
              "scroll-divider": {
                "$type": "color",
                "$value": "{brand.palettes.palette-1.100.color.on-tone}"
              },
              "title": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.surface}"
              }
            },
            "layer-3": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.core-colors.alert.interactive}"
              },
              "scroll-divider": {
                "$type": "color",
                "$value": "{brand.palettes.palette-1.100.color.on-tone}"
              },
              "title": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.surface}"
              }
            }
          },
          "button-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.gutters.vertical}"
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.none}"
          },
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "scroll-divider-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "horizontal-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.gutters.horizontal}"
          },
          "vertical-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.md}"
          },
          "min-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 32
            }
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 9999
            }
          },
          "min-height": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 20
            }
          },
          "max-height": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 80
            }
          },
          "elevation": {
            "$value": "{brand.elevations.elevation-4}",
            "$extensions": {
              "recursica.type": "elevation"
            }
          },
          "header-style": {
            "$type": "typography",
            "$value": "{brand.typography.h6}"
          },
          "content-style": {
            "$type": "typography",
            "$value": "{brand.typography.h2}"
          }
        }
      }
    }
  }
}