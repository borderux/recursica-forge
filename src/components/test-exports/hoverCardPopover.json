{
  "ui-kit": {
    "components": {
      "hover-card-popover": {
        "properties": {
          "colors": {
            "layer-0": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.elements.interactive.tone}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-0.properties.surface}"
              }
            },
            "layer-1": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.elements.interactive.tone}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-1.properties.surface}"
              }
            },
            "layer-2": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.elements.interactive.tone}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-2.properties.surface}"
              }
            },
            "layer-3": {
              "background-color": {
                "$type": "color",
                "$value": "{brand.palettes.core-colors.alert.interactive}"
              },
              "content": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.border-color}"
              },
              "border-color": {
                "$type": "color",
                "$value": "{brand.layers.layer-3.properties.surface}"
              }
            }
          },
          "content-text": {
            "font-family": {
              "$type": "string",
              "$value": "{brand.fonts.secondary}"
            },
            "font-size": {
              "$type": "dimension",
              "$value": "{tokens.font.sizes.sm}"
            },
            "font-weight": {
              "$type": "number",
              "$value": "{tokens.opacities.ghost}"
            },
            "letter-spacing": {
              "$type": "string",
              "$value": "{tokens.font.styles.normal}"
            },
            "line-height": {
              "$type": "number",
              "$value": "{tokens.font.line-heights.shorter}"
            },
            "text-decoration": {
              "$type": "string",
              "$value": "{tokens.font.letter-spacings.default}"
            },
            "text-transform": {
              "$type": "string",
              "$value": "{tokens.font.cases.uppercase}"
            },
            "font-style": {
              "$type": "string",
              "$value": "{ui-kit.components.button}"
            }
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.none}"
          },
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 200
            }
          },
          "horizontal-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.gutters.horizontal}"
          },
          "vertical-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.md}"
          },
          "min-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 20
            }
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 40
            }
          },
          "beak-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 180
            }
          },
          "elevation": {
            "$value": "{brand.elevations.elevation-2}",
            "$extensions": {
              "recursica.type": "elevation"
            }
          }
        }
      }
    }
  }
}