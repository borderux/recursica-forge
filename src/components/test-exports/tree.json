{
  "ui-kit": {
    "components": {
      "tree": {
        "properties": {
          "indent": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.none}"
          },
          "item-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "button-node-gap": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "max-width": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 5
            }
          },
          "border-size": {
            "$type": "dimension",
            "$value": {
              "unit": "px",
              "value": 100
            }
          },
          "border-radius": {
            "$type": "dimension",
            "$value": "{brand.dimensions.border-radii.lg}"
          },
          "vertical-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.xl}"
          },
          "horizontal-padding": {
            "$type": "dimension",
            "$value": "{brand.dimensions.general.none}"
          }
        },
        "variants": {
          "selection-states": {
            "selected": {
              "properties": {
                "colors": {
                  "layer-0": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.300.color.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-2.050.color.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.default.color.on-tone}"
                    }
                  },
                  "layer-1": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.300.color.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-2.050.color.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.default.color.on-tone}"
                    }
                  },
                  "layer-2": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.300.color.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-2.050.color.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.default.color.on-tone}"
                    }
                  },
                  "layer-3": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.300.color.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-2.050.color.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.palettes.palette-1.default.color.on-tone}"
                    }
                  }
                },
                "text": {
                  "font-family": {
                    "$type": "string",
                    "$value": "{tokens.font.cases.original}"
                  },
                  "font-size": {
                    "$type": "dimension",
                    "$value": "{tokens.font.sizes.sm}"
                  },
                  "font-weight": {
                    "$type": "number",
                    "$value": "{tokens.opacities.ghost}"
                  },
                  "letter-spacing": {
                    "$type": "string",
                    "$value": "{tokens.font.styles.normal}"
                  },
                  "line-height": {
                    "$type": "number",
                    "$value": "{tokens.font.line-heights.shorter}"
                  },
                  "text-decoration": {
                    "$type": "string",
                    "$value": "{tokens.font.letter-spacings.default}"
                  },
                  "text-transform": {
                    "$type": "string",
                    "$value": "{tokens.font.cases.uppercase}"
                  },
                  "font-style": {
                    "$type": "string",
                    "$value": "{ui-kit.components.button}"
                  }
                }
              }
            },
            "unselected": {
              "properties": {
                "colors": {
                  "layer-0": {
                    "background-color": {
                      "$type": "color",
