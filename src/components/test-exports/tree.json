                      "$value": "{brand.layers.layer-0.elements.interactive.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.elements.interactive.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-2.properties.border-color}"
                    }
                  },
                  "layer-3": {
                    "background-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.elements.interactive.tone}"
                    },
                    "border-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-0.elements.interactive.tone}"
                    },
                    "text-color": {
                      "$type": "color",
                      "$value": "{brand.layers.layer-3.properties.border-color}"
                    }
                  }
                },
                "text": {
                  "font-family": {
                    "$type": "string",
                    "$value": "{tokens.font.cases.original}"
                  },
                  "font-size": {
                    "$type": "dimension",
                    "$value": "{tokens.font.sizes.sm}"
                  },
                  "font-weight": {
                    "$type": "number",
                    "$value": "{tokens.opacities.ghost}"
                  },
                  "letter-spacing": {
                    "$type": "string",
                    "$value": "{tokens.font.styles.normal}"
                  },
                  "line-height": {
                    "$type": "number",
                    "$value": "{tokens.font.line-heights.shorter}"
                  },
                  "text-decoration": {
                    "$type": "string",
                    "$value": "{tokens.font.letter-spacings.default}"
                  },
                  "text-transform": {
                    "$type": "string",
                    "$value": "{tokens.font.cases.uppercase}"
                  },
                  "font-style": {
                    "$type": "string",
                    "$value": "{ui-kit.components.button}"
                  }
                }
              }
            }
          }
        }
      }
    }
